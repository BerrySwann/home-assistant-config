  nav_bar:
    card:
      type: vertical-stack
      cards:
        - type: custom:navbar-card
          routes:
            - url: /dashboard-tablette/home
              icon: mdi:home
              label: Home
            - url: /dashboard-tablette/lumieres
              icon: mdi:lightbulb
              label: lum.
            - url: /dashboard-tablette/clim
              icon: mdi:air-conditioner
              label: Clim
            - url: /dashboard-tablette/stores
              icon: mdi:window-shutter
              label: Stores
            - url: /dashboard-tablette/prises
              icon: mdi:power-plug-off
              label: Prises
            - icon: mdi:dots-horizontal
              label: More
              tap_action:
                action: open-popup
              popup:
                - icon: mdi:cog
                  url: /config/dashboard
                - icon: mdi:hammer
                  url: /developer-tools/yaml
                - icon: mdi:power
                  tap_action:
                    action: call-service
                    service: homeassistant.restart
                    service_data: {}
                    confirmation:
                      text: Are you sure you want to restart Home Assistant?
          card_mod:
            style: |
              ha-card {
                background: black !important;
                box-shadow: none !important;
                border: none !important;
              }
  calcule_temp_cible:
    card:
      type: vertical-stack
      cards:
        - type: markdown
          content: >
            **<<< CALCUL DE LA TEMPERATURE CIBLE >>>**

            {% set temp_ext = states('sensor.th_balcon_nord_temperature') |
            float(-999) %} {% set consigne_de_base =
            states('sensor.consigne_de_base') | int(0) %} {% set mode =
            states('sensor.mode_ete_hiver') %} {% set temp_eco =
            states('sensor.temperature_eco_hiver') | int(0) %} {% set temp_eco_c
            = states('sensor.temperature_eco_hiver_corrige') | int(0) %} {% set
            temp_hg = states('sensor.temperature_hors_gel_hiver') | int(0) %} {%
            set temp_diff = states('sensor.temperature_differentielle') | int(0)
            %} {% set delta_1 = states('sensor.delta_1') | int(0) %} {% set
            delta_2 = states('sensor.delta_2') | int(0) %} {% set delta_5 =
            states('sensor.delta_5') | int(0) %} {% set delta_7 =
            states('sensor.delta_7') | int(0) %} {% set temp_cible =
            states('sensor.temperature_cible') | int(0) %} {% set temp_confort =
            states('sensor.temperature_confort_jour') | int(0) %} {% set
            temp_confort_n = states('sensor.temperature_confort_nuit') | int(0)
            %}

            **Température Extérieure: {{ temp_ext | round(2) }}°C**

             **Résumé des valeurs actuel :**

            {% if temp_ext < 10 %}
              **- Calcul T°cible si T°Ext. ≤ 10°C [ {{ consigne_de_base }} + {{ delta_2 }} = {{ (consigne_de_base + delta_2) | round(0) }}°C ]**
              **- Température cible [ {{ temp_cible | round(0) }}°C ]**
              
              **- Calcul T°Diff. si T°Ext. ≤ 10°C [ {{ temp_diff }} + {{ delta_2 }} = {{ (temp_diff + delta_2) | round(0) }}°C ]**
              **- Température confort [ {{ temp_confort | round(0) }}°C ]**
              
              **- Température confort de nuit [ {{ temp_confort_n | round(0) }}°C ] (21h <-> 7h30)**
              
              **- Calcul T°éCO si T°Ext. ≤ 10°C [ {{ temp_eco }} + {{ delta_1 }} = {{ (temp_eco + delta_1) | round(0) }}°C ]**
              **- Température éCO corrigé: {{ temp_eco_c }}°C (éCO. si absents)**
            {% elif temp_ext < 12 %}
              **- Calcul T°cible si T°Ext. ≤ 12°C [ {{ consigne_de_base }} + {{ delta_1 }} = {{ (consigne_de_base + delta_1) | round(0) }}°C ]**
              **- Température cible [ {{ temp_cible | round(0) }}°C ]**

              **- Calcul T°Diff. si T°Ext. ≤ 12°C [ {{ temp_diff }} + {{ delta_1 }} = {{ (temp_diff + delta_1) | round(0) }}°C ]**
              **- Température confort [ {{ temp_confort | round(0) }}°C ]**
              
              **- Température confort de nuit [ {{ temp_confort_n | round(0) }}°C ] (21h <-> 7h30)**
              **- Température éCO. : {{ temp_eco_c | round(0) }}°C -> (éCO. si absents)**
            {% elif temp_ext > 40 %}
              **- Calcul T°cible si T°Ext. ≥ 40°C [ {{ temp_ext | round(0) }} - {{ delta_7 }} = {{ (temp_ext - delta_7) | round(0) }}°C ]**
              **- Température cible [ {{ temp_cible | round(0) }}°C ]**
              **- Température confort [ {{ temp_confort | round(0) }}°C ]**
            {% elif temp_ext > 32 %}
              **- Calcul T°cible si T°Ext. ≥ 32°C [ {{ temp_ext | round(0) }} - {{ delta_5 }} = {{ (temp_ext - delta_5) | round(0) }}°C ]**
              **- Température cible [ {{ temp_cible | round(0) }}°C ]**
              **- Température confort [ {{ temp_confort | round(0) }}°C ]**
            {% else %}
              **- Température cible [ {{ temp_cible | round(0) }}°C ]**
              **- Température confort [ {{ temp_confort | round(0) }}°C ]**
              {% if mode == "heat" %} **- Température confort de nuit [ {{ temp_confort_n | round(0) }}°C ] (21h <-> 7h30)**  {% endif %}
              {% if temp_ext < 17 %} **- Température éCO. : {{ temp_eco_c | round(0) }}°C -> (éCO. si absents)** {% endif %}
            {% endif %}

            **Résumé des valeurs de base :**

            - Consigne de Base : {{ consigne_de_base }}°C

            - Température Cible : {{ temp_cible | round(0) }}°C

            - Température différentielle : {{ temp_diff | round(0) }}°C ->
            (Confort)

            - Température éCO. : {{ temp_eco | round(0) }}°C -> (éCO. si
            absents)



            **DELTA: {{ states('sensor.temperature_delta') | default('N/A') }}**


            **MODE: {{ states('sensor.mode_ete_hiver') | upper | default('N/A')
            }}**


            **Groupe = {{ states('sensor.groupe_clim') | default('N/A') }} -
            Presence = {{ states('sensor.presence_clim')  | default('N/A') }}**
          card_mod:
            style: |
              ha-card {
                border: none !important;
                box-shadow: none !important;
                background: transparent;
              }
        - type: conditional
          conditions:
            - condition: state
              entity: binary_sensor.est_jour_6h_21h
              state: 'on'
            - condition: state
              entity: sensor.groupe_clim
              state: groupe_1
          card:
            type: markdown
            content: >
              **{{ states('sensor.presence_clim') }} (6h ⟷ 21h)** {% if
              is_state('sensor.mode_ete_hiver', 'heat') %}
                - Climatiseur Salon : {{ states('sensor.temperature_eco_hiver_corrige') | int }}°C (éCO Heat)
                - Climatiseur Bureau : {{ states('sensor.temperature_eco_hiver_corrige') | int }}°C (éCO Heat)
                - Climatiseur Chambre : {{ states('sensor.temperature_eco_hiver_corrige') | int }}°C (éCO Heat)
              {% elif is_state('sensor.mode_ete_hiver', 'cool') %}
                - Climatiseur Salon : {{ states('sensor.temperature_cible') | int }}°C (Cool)
                - Climatiseur Bureau : {{ states('sensor.temperature_cible') | int }}°C (Cool)
                - Climatiseur Chambre : {{ states('sensor.temperature_cible') | int }}°C (Cool)
              {% else %}
                - Climatiseur Salon : Fan Only
                - Climatiseur Bureau : Fan Only
                - Climatiseur Chambre : Fan Only
              {% endif %}
            text_only: true
        - type: conditional
          conditions:
            - condition: state
              entity: binary_sensor.est_jour_6h_21h
              state: 'on'
            - condition: state
              entity: sensor.groupe_clim
              state: groupe_2
          card:
            type: markdown
            content: >
              **{{ states('sensor.presence_clim') }} (6h ⟷ 21h)**  {% if
              is_state('sensor.mode_ete_hiver', 'heat') %}
                - Climatiseur Salon : {{ states('sensor.temperature_confort') | int }}°C (Heat)
                - Climatiseur Bureau : {{ states('sensor.temperature_cible') | int }}°C (Heat)
                - Climatiseur Chambre : {{ states('sensor.temperature_cible') | int }}°C (Heat)
              {% elif is_state('sensor.mode_ete_hiver', 'cool') %}
                - Climatiseur Salon : {{ states('sensor.temperature_confort') | int }}°C (Cool)
                - Climatiseur Bureau : {{ states('sensor.temperature_cible') | int }}°C (Cool)
                - Climatiseur Chambre : {{ states('sensor.temperature_cible') | int }}°C (Cool)
              {% else %}
                - Climatiseur Salon : Off
                - Climatiseur Bureau : Off
                - Climatiseur Chambre : Off
              {% endif %}
            text_only: true
        - type: conditional
          conditions:
            - condition: state
              entity: binary_sensor.est_jour_6h_21h
              state: 'on'
            - condition: state
              entity: sensor.groupe_clim
              state: groupe_3
          card:
            type: markdown
            content: >
              **{{ states('sensor.presence_clim') }} (6h ⟷ 21h)** {% if
              is_state('sensor.mode_ete_hiver', 'heat') %}
                - Climatiseur Salon : {{ states('sensor.temperature_cible') | int }}°C (Heat)
                - Climatiseur Bureau : {{ states('sensor.temperature_confort') | int }}°C (Heat)
                - Climatiseur Chambre : {{ states('sensor.temperature_cible') | int }}°C (Heat)
              {% elif is_state('sensor.mode_ete_hiver', 'cool') %}
                - Climatiseur Salon : {{ states('sensor.temperature_cible') | int }}°C (Cool)
                - Climatiseur Bureau : {{ states('sensor.temperature_confort') | int }}°C (Cool)
                - Climatiseur Chambre : {{ states('sensor.temperature_cible') | int }}°C (Cool)
              {% else %}
                - Climatiseur Salon : Off
                - Climatiseur Bureau : Off
                - Climatiseur Chambre : Off
              {% endif %}    
            text_only: true
        - type: conditional
          conditions:
            - condition: state
              entity: binary_sensor.est_jour_6h_21h
              state: 'on'
            - condition: state
              entity: sensor.groupe_clim
              state: groupe_4
          card:
            type: markdown
            content: |
              **{{ states('sensor.presence_clim') }} (6h ⟷ 21h)**
              {% if is_state('sensor.mode_ete_hiver', 'heat') %}
                - Climatiseur Salon : {{ states('sensor.temperature_confort') | int }}°C (Heat)
                - Climatiseur Bureau : {{ states('sensor.temperature_confort') | int }}°C (Heat)
                - Climatiseur Chambre : {{ states('sensor.temperature_cible') | int }}°C (Heat)
              {% elif is_state('sensor.mode_ete_hiver', 'cool') %}
                - Climatiseur Salon : {{ states('sensor.temperature_confort') | int }}°C (Cool)
                - Climatiseur Bureau : {{ states('sensor.temperature_confort') | int }}°C (Cool)
                - Climatiseur Chambre : {{ states('sensor.temperature_cible') | int }}°C (Cool)
              {% else %}
                - Climatiseur Salon : Off
                - Climatiseur Bureau : Off
                - Climatiseur Chambre : Off
              {% endif %}
            text_only: true
        - type: conditional
          conditions:
            - condition: state
              entity: binary_sensor.est_nuit_21h_6h
              state: 'on'
            - condition: state
              entity: sensor.groupe_clim
              state: groupe_1
          card:
            type: markdown
            content: >
              **{{ states('sensor.presence_clim') }} (21h ⟷ 6h)** {% if
              is_state('sensor.mode_ete_hiver', 'heat') %}
                - Climatiseur Salon : {{ states('sensor.temperature_eco_hiver_corrige') | int }}°C (éCO Heat)
                - Climatiseur Bureau : {{ states('sensor.temperature_eco_hiver_corrige') | int }}°C (éCO Heat)
                - Climatiseur Chambre : {{ states('sensor.temperature_eco_hiver_corrige') | int }}°C (éCO Heat)
              {% elif is_state('sensor.mode_ete_hiver', 'cool') %}
                - Climatiseur Salon : {{ states('sensor.temperature_cible') | int }}°C (Cool)
                - Climatiseur Bureau : {{ states('sensor.temperature_cible') | int }}°C (Cool)
                - Climatiseur Chambre : {{ states('sensor.temperature_cible') | int }}°C (Cool)
              {% else %}
                - Climatiseur Salon : Fan Only
                - Climatiseur Bureau : Fan Only
                - Climatiseur Chambre : Fan Only
              {% endif %}
            text_only: true
        - type: conditional
          conditions:
            - condition: state
              entity: binary_sensor.est_nuit_21h_6h
              state: 'on'
            - condition: state
              entity: sensor.groupe_clim
              state_not: groupe_1
          card:
            type: markdown
            content: >
              **{{ states('sensor.presence_clim') }} (21h ⟷ 6h)** {% if
              is_state('sensor.mode_ete_hiver', 'heat') %}
                - Climatiseur Salon : {{ states('sensor.temperature_confort_nuit') | int }}°C (Heat)
                - Climatiseur Bureau : {{ states('sensor.temperature_confort_nuit') | int }}°C (Heat)
                - Climatiseur Chambre : {{ states('sensor.temperature_confort_nuit') | int }}°C (Heat)
              {% elif is_state('sensor.mode_ete_hiver', 'cool') %}
                - Climatiseur Salon : {{ states('sensor.temperature_cible') | int }}°C (Cool)
                - Climatiseur Bureau : {{ states('sensor.temperature_cible') | int }}°C (Cool)
                - Climatiseur Chambre : {{ states('sensor.temperature_confort_nuit') | int }}°C (Cool)
              {% else %}
                - Climatiseur Salon : Off
                - Climatiseur Bureau : Off
                - Climatiseur Chambre : Off
              {% endif %}
            text_only: true
