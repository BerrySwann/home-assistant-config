streamline_templates:
  clim_ampere_ring-tile:
    card:
      type: vertical-stack
      cards:
        - type: custom:ring-tile
          name: '[[card_name]]'
          entity: '[[entity]]'
          ring_entity: '[[entity]]'
          ring_type: open
          ring_size: 3
          scale: ticks_with_labels
          top_element: none
          middle_element: value_with_unit
          bottom_element: name
          colorize_icon: true
          indicator: dot
          min: 0
          max: 10
          colour:
            '0': ha_green
            '4': ha_green
            '5': ha_orange
            '6': ha_orange
            '7': ha_red
            '10': ha_red
          card_mod:
            style: |
              ha-card {
                background: none !important;
                border: none !important;
                box-shadow: none !important;
              }
  clim_voltage_ring-tile:
