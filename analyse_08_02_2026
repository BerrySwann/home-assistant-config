- name: "Temperature Corrigé Mamour Hivers SOLAIRE"
  unique_id: "temperature_corrige_mamour_hivers_solaire"
  unit_of_measurement: "°C"
  device_class: temperature
  state: >
    {% set temp_conf_m = states('sensor.temperature_confort_jour') | float(20) %}
    {% set delta_1 = states('sensor.delta_1') | float(1) %}
    {% set heure_actuelle = now().hour %}
    
