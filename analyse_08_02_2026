### 6.4 TEMPLATES DE REQUÊTES SQL (EXPORT AVANCÉ)

#### Requête 1 : Consommation Horaire Détaillée (7 jours)
```sql
-- Export complet Pôle Chauffage
SELECT 
  strftime('%Y-%m-%d', datetime(s_salon.last_updated_ts, 'unixepoch', 'localtime')) as date,
  strftime('%H', datetime(s_salon.last_updated_ts, 'unixepoch', 'localtime')) as heure,
  ROUND(AVG(CAST(s_salon.state AS REAL)), 2) as salon_w,
  ROUND(AVG(CAST(s_bureau.state AS REAL)), 2) as bureau_w,
  ROUND(AVG(CAST(s_chambre.state AS REAL)), 2) as chambre_w,
  ROUND(AVG(CAST(t_ext.state AS REAL)), 1) as temp_ext,
  ROUND(AVG(CAST(t_salon.state AS REAL)), 1) as temp_salon,
  ROUND(AVG(CAST(t_bureau.state AS REAL)), 1) as temp_bureau,
  ROUND(AVG(CAST(t_chambre.state AS REAL)), 1) as temp_chambre
FROM states s_salon
LEFT JOIN states s_bureau 
  ON strftime('%Y-%m-%d %H', datetime(s_bureau.last_updated_ts, 'unixepoch')) = 
     strftime('%Y-%m-%d %H', datetime(s_salon.last_updated_ts, 'unixepoch'))
  AND s_bureau.entity_id = 'sensor.clim_bureau_nous_power'
LEFT JOIN states s_chambre 
  ON strftime('%Y-%m-%d %H', datetime(s_chambre.last_updated_ts, 'unixepoch')) = 
     strftime('%Y-%m-%d %H', datetime(s_salon.last_updated_ts, 'unixepoch'))
  AND s_chambre.entity_id = 'sensor.clim_chambre_nous_power'
LEFT JOIN states t_ext
  ON strftime('%Y-%m-%d %H', datetime(t_ext.last_updated_ts, 'unixepoch')) = 
     strftime('%Y-%m-%d %H', datetime(s_salon.last_updated_ts, 'unixepoch'))
  AND t_ext.entity_id = 'sensor.th_balcon_nord_temperature'
LEFT JOIN states t_salon
  ON strftime('%Y-%m-%d %H', datetime(t_salon.last_updated_ts, 'unixepoch')) = 
     strftime('%Y-%m-%d %H', datetime(s_salon.last_updated_ts, 'unixepoch'))
  AND t_salon.entity_id = 'sensor.th_salon_temperature'
LEFT JOIN states t_bureau
  ON strftime('%Y-%m-%d %H', datetime(t_bureau.last_updated_ts, 'unixepoch')) = 
     strftime('%Y-%m-%d %H', datetime(s_salon.last_updated_ts, 'unixepoch'))
  AND t_bureau.entity_id = 'sensor.th_bureau_temperature'
LEFT JOIN states t_chambre
  ON strftime('%Y-%m-%d %H', datetime(t_chambre.last_updated_ts, 'unixepoch')) = 
     strftime('%Y-%m-%d %H', datetime(s_salon.last_updated_ts, 'unixepoch'))
  AND t_chambre.entity_id = 'sensor.th_chambre_temperature'
WHERE s_salon.entity_id = 'sensor.clim_salon_nous_power'
  AND s_salon.last_updated_ts > strftime('%s', datetime('now', '-7 days'))
  AND s_salon.state NOT IN ('unknown', 'unavailable')
GROUP BY date, heure
ORDER BY date, heure;
```

#### Requête 2 : Analyse ΔT (Écart Thermique) vs Consommation
```sql
-- Corrélation Température Extérieure vs Effort de Chauffage
SELECT 
  date,
  temp_ext_moy,
  ROUND(SUM(salon_kwh + bureau_kwh + chambre_kwh), 2) as total_kwh,
  ROUND(AVG(delta_t), 1) as delta_t_moyen
FROM (
  SELECT 
    strftime('%Y-%m-%d', datetime(last_updated_ts, 'unixepoch', 'localtime')) as date,
    AVG(CAST(state AS REAL)) as temp_ext_moy
  FROM states
  WHERE entity_id = 'sensor.th_balcon_nord_temperature'
    AND last_updated_ts > strftime('%s', datetime('now', '-14 days'))
  GROUP BY date
) t_ext
LEFT JOIN (
  SELECT 
    strftime('%Y-%m-%d', datetime(last_updated_ts, 'unixepoch', 'localtime')) as date,
    SUM(CAST(state AS REAL)) as salon_kwh
  FROM states
  WHERE entity_id = 'sensor.clim_salon_nous_daily'
  GROUP BY date
) salon ON t_ext.date = salon.date
-- (Ajouter bureau et chambre de la même façon)
GROUP BY date
ORDER BY date;
```

